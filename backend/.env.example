# AI-POWERED-LESSON-PLAN-AUTOMATION-SYSTEM Configuration Example

APP_NAME=AI Lesson Plan Automation API
APP_VERSION=1.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=lesson_plan_db

# Authentication / Security
JWT_SECRET_KEY=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq AI Model Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CORS Configuration (comma-separated origins)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10

# OCR Settings (scanned PDFs)
OCR_MIN_MEANINGFUL_CHARS=20
OCR_RENDER_ZOOM=2.0
